#merge sort
def merge(arr):
    if len(arr)>1:
        l=arr[:len(arr)//2]
        r=arr[len(arr)//2:]
        merge(l)
        merge(r)
        i=j=k=0
        if i<len(l) and j<len(r):
            if l[i]<r[j]:
                arr[k]=l[i]
                i+=1
            else:
                arr[k]=r[j]
                j+=1
            k+=1
        while i<len(l):
            arr[k]=l[i]
            i+=1
            k+=1
        while j<len(r):
            arr[k]=r[j]
            j+=1
            k+=1
    return arr
user=input("enter the elements:")
arr=list(map(int,user.split()))
print(merge(arr))
